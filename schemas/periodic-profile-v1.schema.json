{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniform-lab.invalid/schemas/periodic-profile-v1.schema.json",
  "title": "UNIFORM rational periodic profile",
  "type": "object",
  "required": ["schema", "profile"],
  "properties": {
    "schema": {"const": "uniform.periodic-profile/v1"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "period": {"type": "integer", "minimum": 1},
    "algebraic_definition": {"type": "object"},
    "profile": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rational"}}}
  },
  "$defs": {"rational": {"type": ["string", "integer"], "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}},
  "additionalProperties": false
}
