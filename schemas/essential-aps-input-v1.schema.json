{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniform-lab.invalid/schemas/essential-aps-input-v1.schema.json",
  "title": "UNIFORM essential APS rational-polytope input",
  "type": "object",
  "required": ["schema", "sets"],
  "properties": {
    "schema": {"const": "uniform.essential-aps-input/v1"},
    "sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["vertices"],
          "properties": {
            "vertices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/rational"}
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}
      ]
    }
  },
  "additionalProperties": false
}
