{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniform-lab.invalid/schemas/stationary-profile-v1.schema.json",
  "title": "UNIFORM rational stationary stochastic-game profile",
  "type": "object",
  "required": ["schema", "profile"],
  "properties": {
    "schema": {"const": "uniform.stationary-profile/v1"},
    "profile": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rational"}}}}
  },
  "$defs": {"rational": {"type": ["string", "integer"], "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}},
  "additionalProperties": false
}
