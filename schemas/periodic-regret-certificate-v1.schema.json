{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniform-lab.invalid/schemas/periodic-regret-certificate-v1.schema.json",
  "title": "UNIFORM exact bounded-period regret certificate",
  "type": "object",
  "required": ["schema", "scope", "period", "values_by_start_phase", "best_deviation_values_by_start_phase", "regrets_by_start_phase", "maximum_regret", "maximizing_policies"],
  "properties": {
    "schema": {"const": "uniform.periodic-regret-certificate/v1"},
    "scope": {"type": "string", "minLength": 1},
    "period": {"type": "integer", "minimum": 1},
    "values_by_start_phase": {"$ref": "#/$defs/matrix"},
    "best_deviation_values_by_start_phase": {"$ref": "#/$defs/matrix"},
    "regrets_by_start_phase": {"$ref": "#/$defs/matrix"},
    "maximum_regret": {"$ref": "#/$defs/rational"},
    "maximizing_policies": {"type": "array"}
  },
  "$defs": {
    "rational": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"},
    "matrix": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rational"}}}
  },
  "additionalProperties": false
}
